{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.6.1",
  "default_locale": "en",
  "description": "__MSG_extDescription__",
  "permissions": [
    "contextMenus",
    "scripting"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://www.x.com/*",
    "https://twitter.com/*",
    "https://www.twitter.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "__MSG_actionTitle__"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://www.x.com/*",
        "https://twitter.com/*",
        "https://www.twitter.com/*"
      ],
      "js": [
        "post-url.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "homepage_url": "https://github.com/Driedsandwich/postcloak"
}
