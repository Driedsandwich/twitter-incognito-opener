{
  "manifest_version": 3,
  "name": "Twitter Incognito Opener",
  "version": "1.4.0",
  "default_locale": "en",
  "description": "Opens an x.com post in an Incognito window. Works anywhere in the post, not only on links. Shift+Alt click or right-click.",
  "permissions": ["contextMenus", "scripting"],
  "host_permissions": [
    "https://x.com/*",
    "https://www.x.com/*",
    "https://twitter.com/*",
    "https://www.twitter.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://www.x.com/*",
        "https://twitter.com/*",
        "https://www.twitter.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "homepage_url": "https://github.com/Driedsandwich/twitter-incognito-opener"
}
